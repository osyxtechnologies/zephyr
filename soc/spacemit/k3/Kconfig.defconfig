if SOC_SPACEMIT_K3

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 24000000

config RISCV_SOC_INTERRUPT_INIT
	default y

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

# The interrupt controllers are reached through the supervisor external interrupt
config 2ND_LVL_INTR_00_OFFSET
	default 9

config 2ND_LEVEL_INTERRUPT_BITS
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 512

config NUM_IRQS
	default 524

if SMP

config MP_MAX_NUM_CPUS
	default 16

config PM_CPU_OPS
	default y

choice RISCV_SMP_IPI_IMPL
	default RISCV_SMP_IPI_SBI
endchoice

endif # SMP

if UART_NS16550

config UART_NS16550_XSCALE
	default y

config UART_NS16550_ACCESS_WORD_ONLY
	default y

endif # UART_NS16550

endif # SOC_SPACEMIT_K3
