	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		uart0: serial@d4017000 {
			compatible = "ns16550";
			reg = <0x0 0xd4017000 0x0 0x100>;
			reg-shift = <2>;
			clock-frequency = <14745600>;
			interrupt-parent = <&aplic>;
			interrupts = <42 1 6>;
			status = "disabled";
		};

		/*
		 * Supervisor-level interrupt files. Each hart has 64 of them, the
		 * supervisor-level one followed by the 63 guest ones.
		 */
		imsic0: interrupt-controller@e0400000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0400000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <0>;
			status = "okay";
		};

		imsic1: interrupt-controller@e0440000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0440000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <1>;
			status = "disabled";
		};

		imsic2: interrupt-controller@e0480000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0480000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <2>;
			status = "disabled";
		};

		imsic3: interrupt-controller@e04c0000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe04c0000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <3>;
			status = "disabled";
		};

		imsic4: interrupt-controller@e0500000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0500000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <4>;
			status = "disabled";
		};

		imsic5: interrupt-controller@e0540000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0540000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <5>;
			status = "disabled";
		};

		imsic6: interrupt-controller@e0580000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0580000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <6>;
			status = "disabled";
		};

		imsic7: interrupt-controller@e05c0000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe05c0000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <7>;
			status = "disabled";
		};

		imsic8: interrupt-controller@e0600000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0600000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <8>;
			status = "disabled";
		};

		imsic9: interrupt-controller@e0640000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0640000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <9>;
			status = "disabled";
		};

		imsic10: interrupt-controller@e0680000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0680000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <10>;
			status = "disabled";
		};

		imsic11: interrupt-controller@e06c0000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe06c0000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <11>;
			status = "disabled";
		};

		imsic12: interrupt-controller@e0700000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0700000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <12>;
			status = "disabled";
		};

		imsic13: interrupt-controller@e0740000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0740000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <13>;
			status = "disabled";
		};

		imsic14: interrupt-controller@e0780000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe0780000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <14>;
			status = "disabled";
		};

		imsic15: interrupt-controller@e07c0000 {
			compatible = "riscv,imsic";
			reg = <0x0 0xe07c0000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-ids = <511>;
			riscv,hart-id = <15>;
			status = "disabled";
		};

		/* Supervisor-level interrupt domain */
		aplic: interrupt-controller@e0804000 {
			compatible = "riscv,aplic";
			reg = <0x0 0xe0804000 0x0 0x4000>;
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <3>;
			riscv,num-sources = <511>;
			msi-parent = <&imsic0>;
			interrupts-extended = <&hlic0 9 &hlic1 9 &hlic2 9 &hlic3 9
					       &hlic4 9 &hlic5 9 &hlic6 9 &hlic7 9
					       &hlic8 9 &hlic9 9 &hlic10 9 &hlic11 9
					       &hlic12 9 &hlic13 9 &hlic14 9 &hlic15 9>;
		};
	};
};
